# Copy this file to .env and fill in your own values. Never commit .env.

# --- AWS Bedrock model (used by every agent) ---
# Must be in LiteLLM format and start with "bedrock/".
# Newer Claude models (Sonnet 4.5, etc.) are only callable through a
# cross-region inference profile, so prefix the model ID with your region group
# (us. / eu. / apac.) matching AWS_REGION_NAME below.
# Examples:
#   bedrock/us.anthropic.claude-sonnet-4-5-20250929-v1:0
#   bedrock/us.anthropic.claude-3-5-sonnet-20240620-v1:0
#   bedrock/us.meta.llama3-1-70b-instruct-v1:0
MODEL=bedrock/us.anthropic.claude-sonnet-4-5-20250929-v1:0

# --- AWS credentials for Bedrock (local runs only) ---
# In the cloud, the runtime's IAM role provides credentials instead.
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION_NAME=us-east-1

# --- Input statement ---
# Filename (found in src/subscription_auditor/data/) or a full/relative path.
STATEMENT_PATH=bluepine_statement_2026Q3.pdf
